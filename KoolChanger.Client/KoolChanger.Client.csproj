<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net8.0-windows8.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <UseWPF>true</UseWPF>
        <PlatformTarget>x64</PlatformTarget>
        <Platforms>x64</Platforms>
    </PropertyGroup>
    
    <ItemGroup>
        <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
        <PackageReference Include="Microsoft-WindowsAPICodePack-Shell" Version="1.1.5" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
        <PackageReference Include="Microsoft.Xaml.Behaviors.Wpf" Version="1.1.135" />
        <PackageReference Include="WpfAnimatedGif" Version="2.0.2" />
    </ItemGroup>

    <ItemGroup>
        <Page Update="Views\Windows\MainWindow.xaml">
            <Generator>MSBuild:Compile</Generator>
            <XamlRuntime>Wpf</XamlRuntime>
            <SubType>Designer</SubType>
        </Page>
        <Page Update="Views\Dialogs\CustomMessageBox.xaml">
            <Generator>MSBuild:Compile</Generator>
            <XamlRuntime>Wpf</XamlRuntime>
            <SubType>Designer</SubType>
        </Page>
        <Page Update="Views\Dialogs\CustomSkinsForm.xaml">
            <Generator>MSBuild:Compile</Generator>
            <XamlRuntime>Wpf</XamlRuntime>
            <SubType>Designer</SubType>
        </Page>
        <Page Update="Views\Dialogs\SettingsForm.xaml">
            <Generator>MSBuild:Compile</Generator>
            <XamlRuntime>Wpf</XamlRuntime>
            <SubType>Designer</SubType>
        </Page>
    </ItemGroup>

    <ItemGroup>
        <None Include="..\cslolmanager\cslol-tools\build\$(Configuration)\cslol-dll.dll" Link="cslol-dll.dll">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
    </ItemGroup>

    
    <ItemGroup>
        <None Remove="Assets\icon.ico" />
        <None Remove="Assets\logo.gif" />
        <None Remove="Assets\logo128.gif" />
        <None Remove="Assets\logomin.png" />
        <None Remove="Assets\logonew.png" />
        <Resource Include="Assets\icon.ico" />
        <Resource Include="Assets\logo.gif" />
        <None Remove="Assets\trash.png" />
        <Resource Include="Assets\logo128.gif" />
        <Resource Include="Assets\logomin.png" />
        <Resource Include="Assets\trash.png" />
        <None Remove="Assets\settings.png" />
        <Resource Include="Assets\settings.png" />
        <None Remove="Assets\searchicon.png" />
        <Resource Include="Assets\searchicon.png" />
        <None Remove="Assets\minimizeicon.png" />
        <Resource Include="Assets\minimizeicon.png" />
        <None Remove="Assets\logo.png" />
        <Resource Include="Assets\logo.png" />
        <None Remove="Assets\loading.gif" />
        <Resource Include="Assets\loading.gif" />
        <None Remove="Assets\closeicon.png" />
        <Resource Include="Assets\closeicon.png" />
        <None Remove="Assets\champnone.jpg" />
        <Resource Include="Assets\champnone.jpg" />
        <None Remove="Assets\Fonts\Comfortaa-SemiBold.ttf" />
        <Resource Include="Assets\Fonts\Comfortaa-SemiBold.ttf" />
        <None Remove="Assets\Fonts\Comfortaa-Regular.ttf" />
        <Resource Include="Assets\Fonts\Comfortaa-Regular.ttf" />
        <None Remove="Assets\Fonts\Comfortaa-Medium.ttf" />
        <Resource Include="Assets\Fonts\Comfortaa-Medium.ttf" />
        <None Remove="Assets\Fonts\Comfortaa-Light.ttf" />
        <Resource Include="Assets\Fonts\Comfortaa-Light.ttf" />
        <None Remove="Assets\Fonts\Comfortaa-Bold.ttf" />
        <Resource Include="Assets\Fonts\Comfortaa-Bold.ttf" />
    </ItemGroup>


    <ItemGroup>
        <!-- All hash files except the split game hash parts — absolute path so %(RecursiveDir) is relative to hashes\ -->
        <HashesFiles Include="$(MSBuildProjectDirectory)\..\DataDragon\hashes\**\*.*" Exclude="$(MSBuildProjectDirectory)\..\DataDragon\hashes\**\hashes.game.txt.*" />
    </ItemGroup>


    <ItemGroup>
      <Content Include="Assets\logonew.png" />
    </ItemGroup>


    <ItemGroup>
      <Folder Include="Views\Styles\" />
    </ItemGroup>


    <ItemGroup>
      <ProjectReference Include="..\KoolChanger.Core\KoolChanger.Core.csproj" />
    </ItemGroup>

    <!-- $(PublishDir) has a default value in .NET SDK even during regular Build, so use two separate targets -->
    <Target Name="CopyAndMergeHashesBuild" AfterTargets="Build">
        <PropertyGroup>
            <HashesOutputDir>$(TargetDir)hashes</HashesOutputDir>
        </PropertyGroup>
        <MakeDir Directories="$(HashesOutputDir)\lol" />
        <Copy
            SourceFiles="@(HashesFiles)"
            DestinationFiles="@(HashesFiles->'$(HashesOutputDir)\%(RecursiveDir)%(Filename)%(Extension)')" />
        <Exec Command="powershell -NoProfile -Command &quot;Get-Content (Get-ChildItem -Path '$(MSBuildProjectDirectory)\..\DataDragon\hashes\lol' -Filter 'hashes.game.txt.*' | Sort-Object Name | ForEach-Object { $_.FullName }) | Set-Content -Path '$(HashesOutputDir)\lol\hashes.game.txt' -Encoding ASCII&quot;" />
    </Target>

    <Target Name="CopyAndMergeHashesPublish" AfterTargets="Publish">
        <PropertyGroup>
            <HashesOutputDir>$(PublishDir)hashes</HashesOutputDir>
        </PropertyGroup>
        <MakeDir Directories="$(HashesOutputDir)\lol" />
        <Copy
            SourceFiles="@(HashesFiles)"
            DestinationFiles="@(HashesFiles->'$(HashesOutputDir)\%(RecursiveDir)%(Filename)%(Extension)')" />
        <Exec Command="powershell -NoProfile -Command &quot;Get-Content (Get-ChildItem -Path '$(MSBuildProjectDirectory)\..\DataDragon\hashes\lol' -Filter 'hashes.game.txt.*' | Sort-Object Name | ForEach-Object { $_.FullName }) | Set-Content -Path '$(HashesOutputDir)\lol\hashes.game.txt' -Encoding ASCII&quot;" />
    </Target>


</Project>
